# API key de NVIDIA NIM (hosted inference) para el terminal con IA
# Obtén tu clave en: https://build.nvidia.com
NVIDIA_API_KEY=

# Nombre de la secretaria de IA
NVIDIA_ASSISTANT_NAME=NOVA
NEXT_PUBLIC_ASSISTANT_NAME=NOVA

# Opcional: cambiar base URL o modelo
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
# NVIDIA_MODEL=meta/llama-3.1-8b-instruct
